{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Northwind Studio",
  "description": "Notes from Northwind Studio, a small design studio that builds calm, privacy-friendly websites.",
  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#B4532A", "light": "#E08A62", "dark": "#B4532A" },
  "fonts": { "heading": { "family": "Fraunces", "weight": 600 } },
  "background": { "color": { "light": "#F3ECE0", "dark": "#151311" } },
  "navbar": {
    "links": [
      { "label": "Docs", "href": "https://usenotra.com/docs" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" }
    ],
    "cta": { "label": "Work with us", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Studio",
        "items": [
          { "label": "Journal", "href": "/blog" },
          { "label": "Kit changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Built with",
        "items": [
          { "label": "Notra", "href": "https://usenotra.com" },
          { "label": "Notra on GitHub", "href": "https://github.com/usenotra/notra" }
        ]
      }
    ],
    "socials": {
      "bluesky": "https://bsky.app/profile/usenotra.com",
      "instagram": "https://www.instagram.com/usenotra",
      "github": "https://github.com/usenotra/notra"
    }
  },
  "blog": {
    "title": "Journal",
    "description": "How we design, what we measure and what we leave out.",
    "layout": "list",
    "hero": { "style": "plain", "eyebrow": "Northwind Studio" },
    "card": { "readingTime": true },
    "post": { "width": "narrow" }
  },
  "changelog": {
    "title": "Northwind Kit changelog",
    "description": "Releases of Northwind Kit, our open set of components for quiet, cookie-free websites.",
    "layout": "compact"
  },
  "authors": {
    "ines": { "name": "Ines Varga", "title": "Founder, design lead" },
    "pablo": { "name": "Pablo Reyes", "title": "Front-end developer" }
  },
  "integrations": {
    "plausible": { "domain": "northwind-plausible.notra.site" }
  }
}
