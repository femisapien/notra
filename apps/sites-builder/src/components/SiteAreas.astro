---
import { areaHref, params } from "../lib/params";

// Blog/Changelog pills for every mounted area; also a builtin, so a custom header.mdx keeps the switcher.
const sections = (["blog", "changelog"] as const)
  .map((area) => ({ area, label: area === "blog" ? "Blog" : "Changelog", href: areaHref(area), active: area === params.area }))
  .filter((section) => section.href !== null);
---

{
  sections.length > 1 && (
    <nav aria-label="Sections" class="flex shrink-0 items-center gap-0.5 text-sm">
      {sections.map((section) => (
        <a
          href={section.href}
          aria-current={section.active ? "page" : undefined}
          class:list={[
            "flex h-7 items-center rounded-full px-2.5 transition-colors duration-150 ease-out",
            section.active ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/60 hover:text-foreground",
          ]}
        >
          {section.label}
        </a>
      ))}
    </nav>
  )
}
